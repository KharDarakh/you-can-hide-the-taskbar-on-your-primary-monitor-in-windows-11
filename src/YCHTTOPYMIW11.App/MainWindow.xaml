<Window x:Class="YCHTTOPYMIW11.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:YCHTTOPYMIW11.App.ViewModels"
        mc:Ignorable="d"
        Title="YCHTTOPYMIW11 — You Can Hide The Taskbar On Your Primary Monitor In Windows 11"
        Icon="Assets/app.ico"
        Width="1100" Height="750"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern Windows 11 Dark Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
        <SolidColorBrush x:Key="CardBorder" Color="#3D3D3D" />
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA" />
        <SolidColorBrush x:Key="SuccessColor" Color="#28A745" />
        <SolidColorBrush x:Key="WarningColor" Color="#FFC107" />
        <SolidColorBrush x:Key="DangerColor" Color="#DC3545" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#383838" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4D4D4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#484848" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#666666" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fully Custom Windows 11 Dark ComboBox & ComboBoxItem -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Border x:Name="splitBorder" Width="30" HorizontalAlignment="Right" Background="Transparent">
                    <Path x:Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#CCCCCC" Data="M 0 0 L 4 4 L 8 0 Z" />
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="#404040" />
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#707070" />
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#0078D4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3D3D3D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" />
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   Margin="0,2,0,0"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        Background="#252525"
                                        BorderBrush="#444444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer x:Name="dropDownScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Windows 11 Tabs Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,18,0,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Application Layout -->
        <DockPanel Margin="24">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Interactive Logo & Dynamic Accordion Expanding Title -->
                    <Border x:Name="AnimatedTitleContainer" Grid.Column="0" Cursor="Hand" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"
                            Padding="6,4" Margin="-6,-4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#150078D4" />
                                        <Setter Property="BorderBrush" Value="#300078D4" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Official Application Logo -->
                            <Image Source="Assets/app.png" Width="44" Height="44" Margin="0,0,14,0"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Accordion Title Area (YCHTTOPYMIW11 -> You Can Hide The Taskbar...) -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Segment 0: Y[ou ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Y" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_ou" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_ou" Text="ou " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 1: C[an ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="C" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_an" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_an" Text="an " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 2: H[ide ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="H" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_ide" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_ide" Text="ide " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 3: T[he ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="T" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_he" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_he" Text="he " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 4: T[askbar ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="T" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_askbar" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_askbar" Text="askbar " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 5: O[n ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="O" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_n1" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_n1" Text="n " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 6: Y[our ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Y" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_our" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_our" Text="our " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 7: P[rimary ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="P" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_rimary" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_rimary" Text="rimary " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 8: M[onitor ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="M" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_onitor" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_onitor" Text="onitor " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 9: I[n ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="I" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_n2" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_n2" Text="n " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Segment 10: W[indows ] -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="W" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />
                                        <Border x:Name="Box_indows" ClipToBounds="True" Width="0">
                                            <TextBlock x:Name="Txt_indows" Text="indows " FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Ending 11 -->
                                    <TextBlock Text="11" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" />

                                    <Border Background="#0078D4" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="v1.0" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Loc.Subtitle}"
                                           FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Language Selector & Refresh Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Style="{StaticResource ModernDarkComboBox}"
                                  SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                                  Width="130" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="🇹🇷 Türkçe" />
                            <ComboBoxItem Content="🇬🇧 English" />
                        </ComboBox>
                        <Button Content="{Binding Loc.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButton}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Bottom Status Bar -->
            <Border DockPanel.Dock="Bottom" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.StatusLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" Foreground="#00E5FF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="YCHTTOPYMIW11 v1.0" Foreground="#666666" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Tab Control -->
            <TabControl Style="{StaticResource ModernTabControl}">
                <!-- Tab 1: Monitörler & Görev Çubukları -->
                <TabItem Header="{Binding Loc.TabTaskbars}">
                    <DockPanel>
                        <!-- Action Buttons Bar for Monitors -->
                        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{Binding Loc.RestoreDefaults}"
                                        Command="{Binding RestoreDefaultsCommand}"
                                        Style="{StaticResource ModernButton}" />

                                <Button Grid.Column="2" Content="{Binding Loc.ApplyPolicies}"
                                        Command="{Binding ApplyCommand}"
                                        Style="{StaticResource AccentButton}"
                                        Padding="28,10" FontSize="15" />
                            </Grid>
                        </Border>

                        <!-- Monitor Cards List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MonitorCardViewModel}">
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Display Info & Status -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                        <Border Background="#204020" BorderBrush="#308030" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Loc.PrimaryBadge}" FontSize="10" FontWeight="Bold" Foreground="#77FF77" />
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding ResolutionText}" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="  •  " Foreground="#555555" />
                                                        <TextBlock Text="{Binding DpiText}" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="  •  " Foreground="#555555" />
                                                        <TextBlock Text="{Binding Loc.TaskbarLabel}" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="{Binding TaskbarStateText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TaskbarStateColor}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right: Policy Selector -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Loc.TaskbarPolicyLabel}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                    <ComboBox Style="{StaticResource ModernDarkComboBox}"
                                                              SelectedIndex="{Binding SelectedPolicyIndex}">
                                                        <ComboBoxItem Content="{Binding Loc.PolicyAlwaysVisible}" />
                                                        <ComboBoxItem Content="{Binding Loc.PolicyPermanentlyHidden}" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Tab 2: Uygulama ve Kurtarma Ayarları -->
                <TabItem Header="{Binding Loc.TabSettings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,0,0">
                            <!-- Sistem Başlangıcı -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc.SystemStartupHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#FFFFFF" />
                                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="{Binding Loc.StartWithWindows}"
                                              Foreground="#E0E0E0" Margin="0,0,0,12" FontSize="13" />
                                    <CheckBox IsChecked="{Binding StartMinimizedToTray}" Content="{Binding Loc.StartMinimizedToTray}"
                                              Foreground="#E0E0E0" Margin="0,0,0,4" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Kurtarma ve Güvenlik -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc.RecoverySecurityHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#FFFFFF" />
                                    <CheckBox IsChecked="{Binding AutoRecoverOnExplorerRestart}"
                                              Content="{Binding Loc.AutoRecoverExplorer}"
                                              Foreground="#E0E0E0" Margin="0,0,0,12" FontSize="13" />
                                    <CheckBox IsChecked="{Binding AutoRecoverOnDisplayChange}"
                                              Content="{Binding Loc.AutoRecoverDisplay}"
                                              Foreground="#E0E0E0" Margin="0,0,0,4" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Pencere Kapatma Davranışı -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.CloseActionHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding Loc.CloseActionDescription}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                        <ComboBox Style="{StaticResource ModernDarkComboBox}"
                                                  SelectedIndex="{Binding SelectedCloseActionIndex, Mode=TwoWay}"
                                                  Width="380" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="{Binding Loc.CloseActionAsk}" />
                                            <ComboBoxItem Content="{Binding Loc.CloseActionMinimize}" />
                                            <ComboBoxItem Content="{Binding Loc.CloseActionExit}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{Binding Loc.ResetCloseAction}"
                                            Command="{Binding ResetCloseActionCommand}"
                                            Style="{StaticResource ModernButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Tanılama ve Rapor -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc.DiagnosticReportHeader}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#FFFFFF" />
                                        <CheckBox IsChecked="{Binding EnableDiagnosticLogging}" Content="{Binding Loc.EnableDiagnosticLogging}"
                                                  Foreground="#E0E0E0" Margin="0,0,0,4" FontSize="13" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{Binding Loc.DetailedSystemReport}" Command="{Binding GenerateReportCommand}"
                                            Style="{StaticResource ModernButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Close Confirmation Modal Overlay -->
        <Grid Background="#B0000000" Visibility="{Binding IsCloseModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="10"
                    Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/app.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc.CloseModalTitle}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelCloseModalCommand}"
                                Style="{StaticResource ModernButton}" Padding="8,4" FontSize="12" />
                    </Grid>

                    <TextBlock Text="{Binding Loc.CloseModalDescription}" Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <CheckBox IsChecked="{Binding CloseModalRememberChoice}"
                              Content="{Binding Loc.CloseModalRememberChoice}"
                              Foreground="#E0E0E0" FontSize="13" Margin="0,0,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="{Binding Loc.CloseModalMinimize}"
                                Command="{Binding ConfirmMinimizeToTrayCommand}"
                                Style="{StaticResource AccentButton}" Padding="14,10" FontSize="13" />

                        <Button Grid.Column="2" Content="{Binding Loc.CloseModalExit}"
                                Command="{Binding ConfirmExitCommand}"
                                Style="{StaticResource ModernButton}" Padding="14,10" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diagnostic Report Modal Overlay -->
        <Grid Background="#B0000000" Visibility="{Binding IsReportModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8"
                    Margin="40" Padding="20">
                <DockPanel>
                    <!-- Modal Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Loc.DiagnosticModalTitle}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Button Content="{Binding Loc.CloseModal}" Command="{Binding CloseReportModalCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Report Content -->
                    <TextBox Text="{Binding DiagnosticReportText}" IsReadOnly="True"
                             Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#333333"
                             FontFamily="Consolas, Cascadia Code, monospace" FontSize="13"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
